# Create correct .gitignore
@"
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables and secrets
.env
.env.local
*.pem
*.key
*.crt

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
uploads/
temp-uploads/

# AWS
.aws/
aws_config.json

# Docker
.dockerignore
"@ | Out-File -FilePath .gitignore -Encoding UTF8 -Force